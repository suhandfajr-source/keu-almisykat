NEXT_PUBLIC_APP_NAME="Keuangan Pesantren Al-Misykat"
NEXT_PUBLIC_TIMEZONE="Asia/Jakarta"

# Driver Mode (Default 'supabase' untuk Production)
DATABASE_DRIVER="supabase"
STORAGE_DRIVER="supabase"

# Supabase Configuration (Wajib untuk Production)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Catatan:
# 1. Database PostgreSQL, Auth, dan Storage Bucket 'transaction-evidence' dikelola langsung oleh Supabase.
# 2. Akun Admin/Bendahara dibuat melalui Supabase Auth Dashboard atau SQL.
